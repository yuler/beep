{
  "name": "beep",
  "private": true,
  "type": "module",
  "description": "Monorepo for the beep project.",
  "scripts": {
    "setup": "mise run setup",
    "clean": "mise run clean",
    "dev": "mise run dev",
    "core": "mise run core",
    "web:dev": "mise run web:dev",
    "web:build": "mise run web:build",
    "locale:sort": "node scripts/sort-locale-keys.ts",
    "locale:check": "node scripts/check-locale-keys.ts",
    "locale:compile": "pnpm --filter web locale:compile"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}