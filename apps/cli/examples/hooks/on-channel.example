#!/usr/bin/env bash
# hooks/on-channel — one local callback for every CLI channel delivery.
#
# Beeps and channel tests both arrive as ChannelDelivery on this inbox.
# `beep up` always execs this file (see docs/architecture/channel.md §5).
# If BEEP_EVENT_INTENT is set, it dispatches to hooks/on-channel-$intent
# (or hooks/on-channel-<kebab-case-intent>) when available.
#
# Install (workspace root is ~/.beep.local for local dev, ~/.beep for prod):
#   cp apps/cli/examples/hooks/on-channel.example ~/.beep.local/hooks/on-channel
#   chmod 755 ~/.beep.local/hooks/on-channel
#
# Permissions: owned by you, executable, not group/world-writable (isSafeHook).
# Cwd is the workspace root. Exit 0 ACKs succeeded; non-zero ACKs failed.
# No hook file: logged with a warning and ACKed failed so the server can retry. 60s timeout.
#
# Security: BEEP_EVENT* values come from the server payload. Never
# `eval` them or pass them to `sh -c` — branch with `case` like below.
#
# Environment:
#   BEEP_EVENT             Event type, e.g. beep.fired | channel.test
#   BEEP_EVENT_SOURCE      Origin slug: runner_job | beeper | beep
#   BEEP_EVENT_SOURCE_TYPE Polymorphic class, or empty
#   BEEP_EVENT_SOURCE_ID   Unique ID of the trigger source
#   BEEP_EVENT_INTENT      Optional tag you set (any string; e.g. get_off_work)
#   BEEP_EVENT_JSON        Complete delivery payload as a JSON string
#   BEEP_EVENT_ID          Unique delivery ID
#   BEEP_EVENT_TITLE       Notification title
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "[on-channel] event=${BEEP_EVENT:-} source=${BEEP_EVENT_SOURCE:-} intent=${BEEP_EVENT_INTENT:-} id=${BEEP_EVENT_ID:-} title=${BEEP_EVENT_TITLE:-}"
printf 'BEEP_EVENT_JSON=%s\n' "${BEEP_EVENT_JSON:-}"
if command -v jq >/dev/null 2>&1 && [ -n "${BEEP_EVENT_JSON:-}" ]; then
  printf '%s\n' "${BEEP_EVENT_JSON}" | jq .
fi

# Intent-based dispatch: try on-channel-${intent}
if [ -n "${BEEP_EVENT_INTENT:-}" ]; then
  intent="${BEEP_EVENT_INTENT}"
  kebab_intent="${intent//_/-}"
  target_hook=""

  if [ -e "${HOOK_DIR}/on-channel-${kebab_intent}" ]; then
    target_hook="${HOOK_DIR}/on-channel-${kebab_intent}"
  elif [ -e "${HOOK_DIR}/on-channel-${intent}" ]; then
    target_hook="${HOOK_DIR}/on-channel-${intent}"
  fi

  if [ -n "$target_hook" ]; then
    if [ -x "$target_hook" ] && [ ! -d "$target_hook" ]; then
      echo "[on-channel] [INFO] Dispatching to intent hook: ${target_hook}"
      exec "$target_hook" "$@"
    else
      echo "[on-channel] [WARN] Intent hook exists but is not executable: ${target_hook}, continuing default flow..." >&2
    fi
  else
    echo "[on-channel] [WARN] Hook for intent '${intent}' not found (${HOOK_DIR}/on-channel-${kebab_intent}), continuing default flow..." >&2
  fi
fi

case "${BEEP_EVENT:-}" in
  channel.test)
    echo "[on-channel] channel test OK: ${BEEP_EVENT_TITLE:-}"
    ;;
  beep.*)
    case "${BEEP_EVENT_SOURCE:-beep}" in
      runner_job)
        echo "[on-channel] Runner job: ${BEEP_EVENT_TITLE:-}"
        ;;
      beeper)
        echo "[on-channel] Beeper alert/recovery: ${BEEP_EVENT_TITLE:-}"
        ;;
      *)
        echo "[on-channel] Beep reminder: ${BEEP_EVENT_TITLE:-}"
        ;;
    esac
    ;;
  *)
    echo "[on-channel] unhandled event: ${BEEP_EVENT:-}" >&2
    ;;
esac
