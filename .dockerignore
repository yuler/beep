# Docker build context is the monorepo root (`docker build -f core/Dockerfile .`
# or `docker build -f apps/web/Dockerfile .`).
# Keep context small while sending necessary files for both core and web.

.git
.github
.agents
.cursor
.gemini
.superpowers
.vscode
.kamal
.mimocode
docs
materials
scripts
packages
apps/www
apps/admin
apps/mobile
apps/desktop

# Web build artifacts & dependencies
apps/web/dist
apps/web/dist-ssr
apps/web/.output
apps/web/.nitro
apps/web/.tanstack
apps/web/node_modules
node_modules

# Core build artifacts & secrets
core/.bundle
core/config/*.key
core/config/credentials/*.key
core/vendor/bundle

# Global ignores
**/.env*
**/tmp
**/log
**/storage
**/*.md
!README.md
compose*.yml
Procfile.dev
.rubocop.yml
core/.rubocop*.yml
