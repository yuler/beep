<h1><%= @beep.title %></h1>

<% if @beep.body_text.present? %>
  <%= simple_format(@beep.body_text) %>
<% end %>

<p>
  <%= link_to t(:mailer_open_beep, default: "Open beep"), @beep.web_url %>
</p>

<p class="footer">
  <%= link_to t(:email_reminders_turn_off, default: "Turn off email reminders"), @unsubscribe_url %>
</p>
