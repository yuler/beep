<h1><%= @beep.title %></h1>

<% if @run&.check_result&.dig("message").present? %>
  <%= simple_format(@run.check_result["message"]) %>
<% elsif @beep.body_text.present? %>
  <%= simple_format(@beep.body_text) %>
<% end %>

<p>
  <%= link_to "Open beep", @beep.web_url %>
</p>

<p class="footer">
  <%= link_to "Turn off email reminders", @unsubscribe_url %>
</p>
