<div style="font-family: -apple-system, BlinkMacSystemFont, 'Noto Sans CJK SC', 'Source Han Sans SC', 'Noto Sans SC', sans-serif; max-width: 540px; margin: 32px auto; padding: 24px; border: 1px solid #e5e5e5; background: #ffffff; color: #000000;">
  <div style="font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: #888888; margin-bottom: 8px;">
    BEEP
  </div>
  <h1 style="margin: 0 0 12px 0; font-size: 22px; font-weight: 500; color: #000000; line-height: 1.2;">
    <%= @beep.title %>
  </h1>

  <div style="margin-bottom: 20px; font-size: 13px; color: #888888;">
    <span><%= t(:mailer_triggered_at, default: "Triggered at") %>:</span>
    <strong style="color: #000000; font-weight: 400;"><%= @detailed_time %></strong>
  </div>

  <% if @beep.body_text.present? %>
    <div style="margin: 0 0 24px 0; font-size: 14px; line-height: 1.5; color: #000000; border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5; padding: 14px 0;">
      <%= simple_format(@beep.body_text) %>
    </div>
  <% end %>

  <div style="margin: 24px 0 16px 0;">
    <%= link_to t(:mailer_view_in_beep, default: "View in Beep"), @beep.web_url, style: "display: inline-block; background-color: #000000; color: #ffffff; font-size: 14px; text-decoration: none; padding: 12px 20px; border: 1px solid #000000; border-radius: 0;" %>
  </div>

  <p style="margin: 24px 0 0 0; font-size: 12px; color: #888888; text-align: start; border-top: 1px solid #e5e5e5; padding-top: 12px;">
    <%= link_to t(:email_reminders_turn_off, default: "Turn off email reminders"), @unsubscribe_url, style: "color: #888888; text-decoration: underline;" %>
  </p>
</div>
