<h1 class="title"><%= t(:mailer_magic_link_title, default: "Sign in to your account") %></h1>
<p class="subtitle"><%= t(:mailer_magic_link_subtitle, default: "Please enter this 6-character verification code on the sign-in page:") %></p>

<strong class="txt-large"><%= @magic_link.code %></strong>

<p><%= t(:mailer_magic_link_expiration, time: distance_of_time_in_words(MagicLink::EXPIRATION_TIME), default: "This code will work for %{time}.") %></p>

<p class="footer"><%= t(:mailer_need_help, default: "Need help?") %> <%= mail_to "support@example.com", t(:mailer_send_email, default: "Send us an email") %>.</p>
