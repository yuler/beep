<% @page_title = t(:account_invite_new_member, default: "Invite a New Member") %>

<div class="page page--lg">
  <div class="prose">
    <h1><%= t(:account_invite_new_member, default: "Invite a New Member") %></h1>
    <p><%= t(:account_invite_member_lead, account: Current.account.name, default: "Invite someone to join %{account}.") %></p>
  </div>

  <%= form_with(model: @invitation, url: account_invitations_path, class: "form") do |form| %>
    <%= render "shared/form_errors", model: @invitation %>

    <div class="field">
      <%= form.label :email, t(:auth_email, default: "Email"), class: "field__label" %>
      <%= form.email_field :email, required: true, class: "input", placeholder: "colleague@example.com" %>
    </div>

    <div class="flex gap">
      <%= form.submit t(:account_send_invitation, default: "Send Invitation"), class: "btn btn--primary" %>
      <%= link_to t(:common_cancel, default: "Cancel"), account_users_path, class: "btn btn--ghost" %>
    </div>
  <% end %>
</div>
