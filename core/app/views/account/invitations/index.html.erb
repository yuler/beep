<% @page_title = t(:account_invitations, default: "Invitations") %>

<div class="page page--lg">
  <div class="prose">
    <h1><%= t(:account_invitations, default: "Invitations") %></h1>
  </div>

  <%= render "form", model: @account_invitation %>

  <div class="table-scroll margin-block">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(:auth_email, default: "Email") %></th>
          <th><%= t(:common_status, default: "Status") %></th>
          <th><%= t(:account_invited_by, default: "Invited By") %></th>
          <th><%= t(:account_created_at, default: "Created At") %></th>
        </tr>
      </thead>
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr>
            <td><%= invitation.email %></td>
            <td><span class="badge"><%= invitation.status.to_s.humanize %></span></td>
            <td><%= invitation.invited_by&.name || "N/A" %></td>
            <td><%= invitation.created_at %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
