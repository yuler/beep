<% @page_title = t(:account_memberships_title, name: Current.account.name, default: "%{name} Memberships") %>

<div class="page page--lg">
  <div class="flex justify-between items-center margin-block-end">
    <h1 class="txt-x-large font-weight-bold"><%= t(:account_memberships_title, name: Current.account.name, default: "%{name} Memberships") %></h1>
    <%= link_to t(:account_invite_member, default: "Invite Member"), new_account_invitation_path, class: "btn btn--primary" %>
  </div>

  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(:account_name, default: "Name") %></th>
          <th><%= t(:auth_email, default: "Email") %></th>
          <th><%= t(:account_role, default: "Role") %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %></td>
            <td><%= user.identity&.email || "N/A" %></td>
            <td><%= user.role.humanize %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
