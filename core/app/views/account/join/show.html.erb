<% @page_title = t(:account_join_title, name: @join_code.account.name, default: "Join %{name}") %>

<div class="stage">
  <div class="page page--sm">
    <div class="card card--raised">
      <div class="card__body text-center">
        <h2 class="card__title"><%= t(:account_join_title, name: @join_code.account.name, default: "Join %{name}") %></h2>

        <% if @join_code.account.description.present? %>
          <p class="txt-muted"><%= @join_code.account.description %></p>
        <% end %>

        <% if authenticated? %>
          <div class="divider"><%= t(:account_invite_signed_in_as, email: Current.identity.email, default: "Signed in as %{email}") %></div>

          <% if Current.user&.active? %>
            <p class="txt-muted"><%= t(:account_already_member, default: "You're already a member of this account.") %></p>

            <%= link_to t(:common_continue, default: "Continue"),
                  landing_path(script_name: @join_code.account.slug_path),
                  class: "btn btn--primary" %>
          <% else %>
            <div class="flex gap items-center justify-center">
              <%= button_to t(:account_join_account_button, default: "Join account"),
                    account_join_path(params[:code]),
                    method: :post,
                    class: "btn btn--primary" %>
            </div>
          <% end %>
        <% else %>
          <div class="divider"><%= t(:account_invite_login_required, default: "Login required") %></div>

          <p class="txt-muted">
            <%= t(:account_log_in_to_join, name: @join_code.account.name, default: "Log in to join %{name}.") %>
          </p>

          <%= link_to t(:common_login, default: "Login"),
                new_session_path(script_name: nil),
                class: "btn btn--primary" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
