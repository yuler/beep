<% @page_title = t(:account_accounts, default: "Accounts") %>

<div class="page page--lg">
  <div class="prose">
    <h1><%= t(:account_accounts, default: "Accounts") %></h1>
  </div>

  <div class="table-scroll margin-block">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(:account_name, default: "Name") %></th>
          <th><%= t(:account_description, default: "Description") %></th>
          <th><%= t(:account_created_at, default: "Created At") %></th>
          <th><%= t(:account_updated_at, default: "Updated At") %></th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <tr>
            <td><%= link_to account.name, root_path(script_name: account.slug_path) %></td>
            <td><%= account.description %></td>
            <td><%= account.created_at %></td>
            <td><%= account.updated_at %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= link_to t(:account_new_account, default: "New Account"), new_account_path, class: "btn btn--primary" %>
</div>
