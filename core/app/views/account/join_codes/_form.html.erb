<%= form_with model: join_code, url: account_join_code_path, method: :patch, class: "form" do |form| %>
  <%= render "shared/form_errors", model: join_code %>

  <div class="field">
    <%= form.label :usage_limit, class: "field__label" do %>
      <span class="font-weight-semibold"><%= t(:account_usage_limit, default: "Usage Limit") %></span>
    <% end %>
    <%= form.number_field :usage_limit, class: "input", min: join_code.usage_count %>
    <span class="field__hint"><%= t(:account_usage_limit_hint, count: join_code.usage_count, default: "Currently used %{count} times") %></span>
  </div>

  <div class="flex gap">
    <%= form.submit t(:account_update_limit, default: "Update Limit"), class: "btn btn--primary" %>
    <%= link_to t(:common_cancel, default: "Cancel"), edit_account_join_code_path, class: "btn btn--ghost" %>
  </div>
<% end %>
