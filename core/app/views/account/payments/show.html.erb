<% @page_title = "Thank you" %>

<% if @charge.present? && @charge.status == "succeeded" %>
  <div class="page page--lg">
    <div class="prose">
      <h1>Thank you</h1>
      <p class="txt-muted">Your payment was successful. You’re now on the <strong><%= @charge.plan_key %></strong> plan.</p>
      <%= link_to "Done", root_path, class: "btn btn--primary" %>
    </div>
  </div>
<% end %>
