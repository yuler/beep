<% @page_title = t(:payment_thank_you, default: "Thank you") %>

<% if @charge.present? && @charge.status == "succeeded" %>
  <div class="page page--lg">
    <div class="prose">
      <h1><%= t(:payment_thank_you, default: "Thank you") %></h1>
      <p class="txt-muted"><%= t(:payment_success_message, plan: @charge.plan_key, default: "Your payment was successful. You’re now on the %{plan} plan.") %></p>
      <%= link_to t(:common_done, default: "Done"), root_path, class: "btn btn--primary" %>
    </div>
  </div>
<% end %>
