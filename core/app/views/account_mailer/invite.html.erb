<div style="font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; color: #888888; margin-bottom: 8px;">
  BEEP
</div>
<h1 style="margin: 0 0 12px 0; font-size: 24px; font-weight: 500; color: #000000; line-height: 1.2;">
  <%= t(:mailer_invite_title, account: @account.name, default: "You're invited to join %{account}") %>
</h1>

<p style="margin: 0 0 16px 0; color: #000000; font-size: 14px;">
  <%= t(:mailer_invite_body, invited_by: @invited_by.name, account: @account.name, site: ENV.fetch("SITE_NAME"), default: "%{invited_by} invited you to join %{account} on %{site}.") %>
</p>

<p style="margin: 0 0 20px 0; color: #888888; font-size: 13px;">
  <%= t(:mailer_invite_instruction, default: "Open the invitation to accept or decline.") %>
</p>

<div style="margin: 24px 0;">
  <%= link_to t(:mailer_invite_view_button, default: "View invitation"), @invitation.accept_url, style: "display: inline-block; background-color: #000000; color: #ffffff; font-size: 14px; text-decoration: none; padding: 12px 20px; border: 1px solid #000000; border-radius: 0;" %>
</div>
