<% @page_title = t(:auth_sign_in, default: "Sign in") %>
<% @hide_footer = true %>

<section class="auth-stage" aria-labelledby="auth-title">
  <div class="auth-shell">
    <div class="auth-story">
      <div class="auth-brand">
        <span class="auth-brand__mark"><%= render "shared/logo_mark" %></span>
        <span>beep</span>
      </div>

      <div class="auth-story__copy">
        <p class="auth-eyebrow"><%= t(:auth_passwordless_access, default: "Passwordless access") %></p>
        <h1 id="auth-title"><%= t(:auth_sign_in_workspace, default: "Sign in to your workspace.") %></h1>
        <p><%= t(:auth_enter_email_code, default: "Enter your email and we will send a one-time verification code.") %></p>
      </div>

      <div class="auth-preview" aria-hidden="true">
        <div class="auth-preview__row">
          <span class="auth-preview__dot"></span>
          <span class="auth-preview__line auth-preview__line--wide"></span>
          <span class="auth-preview__pill"></span>
        </div>
        <div class="auth-preview__row">
          <span class="auth-preview__dot"></span>
          <span class="auth-preview__line"></span>
          <span class="auth-preview__pill auth-preview__pill--muted"></span>
        </div>
        <div class="auth-preview__row">
          <span class="auth-preview__dot"></span>
          <span class="auth-preview__line auth-preview__line--short"></span>
          <span class="auth-preview__pill"></span>
        </div>
      </div>
    </div>

    <div class="auth-panel">
      <div class="auth-panel__header">
        <h2><%= t(:auth_welcome_back, default: "Welcome back") %></h2>
        <p><%= t(:auth_use_connected_email, default: "Use the email connected to your account.") %></p>
      </div>

      <%= form_with url: session_path, class: "form auth-form" do |form| %>
        <div class="field field--with-icon">
          <%= form.label :email, t(:auth_email_address, default: "Email address"), class: "field__label" %>
          <div class="field__control">
            <span class="field__icon"><%= icon_tag "email" %></span>
            <%= form.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "you@example.com",
              value: params[:email],
              class: "input auth-input" %>
          </div>
        </div>

        <%= form.submit t(:auth_continue, default: "Continue"), class: "btn btn--primary btn--large btn--block auth-submit" %>
      <% end %>

      <p class="auth-terms">
        <%= t(:auth_terms_agreement, default: "By continuing, you agree to our") %> <%= link_to t(:auth_terms_of_service, default: "Terms of Service"), "#", class: "txt-link" %>.
      </p>
    </div>
  </div>
</section>
