<% @page_title = "Home" %>

<div class="page page--lg">
  <div class="prose">
    <h1>Landing page</h1>
    <p class="txt-muted">This is the landing page, <code>landings_controller#show</code> and <code>landings/show.html.erb</code>.</p>

    <div class="flex gap items-center margin-block">
      <span class="txt-large font-weight-bold">You are signed in as <code><%= Current.identity.email %></code>.</span>
      <%= button_to "Sign Out", session_path(script_name: nil), class: "btn btn--negative btn--small", method: :delete %>
    </div>

    <div class="card margin-block">
      <div class="card__body">
        <h2 class="card__title">Current User:</h2>
        <%= debug Current.identity.inspect %>
      </div>
    </div>

    <div class="card margin-block">
      <div class="card__body">
        <h2 class="card__title">Current Account:</h2>
        <%= debug Current.account.inspect %>
        <div class="flex gap items-center">
          <span class="txt-large font-weight-bold">Switch to other account:</span>
          <% Current.identity.accounts.each do |account| %>
            <%= link_to account.name, root_path(script_name: account.slug_path), class: "btn btn--outline btn--small", disabled: Current.account&.id == account.id %>
          <% end %>
        </div>
      </div>
    </div>

    <% url = account_join_url(Current.account.join_code.code, script_name: Current.account.slug_path) %>
    <div class="card margin-block">
      <div class="card__body">
        <h2 class="card__title">Join Url:</h2>
        <div class="flex gap items-center">
          <code class="txt-mono"><%= url %></code>
          <button class="btn btn--outline btn--small position-relative" data-controller="copy-to-clipboard" data-action="copy-to-clipboard#copy" data-copy-to-clipboard-content-value="<%= url %>" data-copy-to-clipboard-success-class="btn-copied">
            <span class="copy-icon"><%= icon_tag "copy" %></span>
            <span class="copied-text">Copied!</span>
          </button>
        </div>
      </div>
    </div>

    <div class="card margin-block">
      <div class="card__body">
        <h2 class="card__title">Payments:</h2>
        <%= button_to account_payment_path(plan_key: "first"), class: "btn btn--primary btn--small", data: { turbo: false, controller: "button-loading" } do %>
          <span data-button-loading-target="text">Create Payment</span>
          <span data-button-loading-target="loading" hidden>
            <span class="spinner" aria-hidden="true"></span>
            Processing...
          </span>
        <% end %>
      </div>
    </div>
  </div>
</div>
