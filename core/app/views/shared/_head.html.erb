<head>
  <%= page_title_tag %>

  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#000000">

  <%# Set dark theme as default before first paint to avoid flash %>
  <script>
    (function () {
      try {
        var theme = localStorage.getItem("theme");
        if (theme !== "light" && theme !== "dark") {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    })();
  </script>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= tag.meta name: "current-user-id", content: Current.user.id if Current.user %>

  <%# Loaded individually (not @import-aggregated) so Hotwire Spark can
      hot-reload each stylesheet per-file. `application.css` declares the
      cascade layers first; the rest participate via their @layer blocks. %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "reset", "base", "theme", "layout", "utilities",
                          "buttons", "forms", "tables", "components", "prose",
                          "header", "footer", "flash", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <%= yield :head %>

  <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
  <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link id="favicon-theme" rel="icon" href="/icon-dark.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
  <script>
    (function () {
      try {
        var theme = document.documentElement.getAttribute("data-theme") || "dark";
        var link = document.getElementById("favicon-theme");
        if (link) link.href = theme === "dark" ? "/icon-dark.svg" : "/icon-light.svg";
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#000000" : "#ffffff");
      } catch (e) {}
    })();
  </script>
</head>
