<% @page_title = t(:account_choose_account, default: "Choose Your Account") %>

<div class="page page--lg">
  <div class="prose">
    <h1><%= t(:account_choose_account, default: "Choose Your Account") %></h1>
    <% if @last_account_slug.present? %>
      <p><%= t(:account_pick_account_last_used, slug: @last_account_slug, default: "Last used: %{slug} — pick an account to continue.") %></p>
    <% else %>
      <p><%= t(:account_pick_account, default: "Pick an account to continue.") %></p>
    <% end %>
  </div>

  <div class="table-scroll margin-block">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(:account_name, default: "Name") %></th>
          <th><%= t(:account_slug, default: "Slug") %></th>
          <th><%= t(:account_description, default: "Description") %></th>
          <th><%= t(:account_settings, default: "Settings") %></th>
          <th><%= t(:account_invitations, default: "Invitations") %></th>
          <th><%= t(:account_created_at, default: "Created At") %></th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <tr class="<%= "is-last-used" if account.slug == @last_account_slug %>">
            <td><%= link_to account.name, root_path(script_name: account.slug_path) %><%= " #{t(:account_last_used_tag, default: '(last used)')}" if account.slug == @last_account_slug %></td>
            <td><%= account.slug %></td>
            <td><%= account.description %></td>
            <td>
              <% if @admin_account_ids.include?(account.id) %>
                <%= link_to t(:account_settings, default: "Settings"), account_settings_path(script_name: account.slug_path), class: "txt-link" %>
              <% end %>
            </td>
            <td>
              <% if @admin_account_ids.include?(account.id) %>
                <%= link_to t(:account_invitations, default: "Invitations"), account_invitations_path(script_name: account.slug_path), class: "txt-link" %>
              <% end %>
            </td>
            <td><%= account.created_at %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= link_to t(:account_create_new_account, default: "Create a New Account"), new_my_account_path, class: "btn btn--primary" %>
</div>
