# =============================================================================
# beep — copy to `.env` and adjust
#   cp .env.example .env
#
# Env files live at the repo root only (no `.env.<environment>` files):
#   1. `.env`       defaults (this file)
#   2. `.env.local` optional overrides (gitignored), loaded last and wins
#
# Loaded only by mise (`_.file` in mise.toml). `mise` interpolates ${VAR}.
# Hosts, ports, and URLs have no fallbacks in the app or `mise dev` — copy
# this file to `.env` (and optionally `.env.local`) so those keys exist.
# Restart the process after changes.
#
# Sections:
#   Global — hosts, ports, site identity (shared by core + web + Compose)
#   Core   — Rails only
#   Web    — apps/web. Browser-inlined vars MUST be VITE_* (Vite).
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
# Local `mise dev` (Mode A). Canonical hosts:
#   Core: http://core.${APP_HOST}:${CORE_PORT}
#   Web:  http://web.${APP_HOST}:${WEB_PORT}
# Vite / Rails accept only these hosts in development (not plain localhost).
APP_HOST=beep.localhost
CORE_PORT=3001
WEB_PORT=3000

# Public hostname (no scheme). Production / Compose: beep.example.com
# Local mailer URLs can keep localhost:3000.
SITE_DOMAIN=localhost:3000
SITE_NAME=beep

# Pin a git tag image for production Compose (default: main).
BEEP_IMAGE_TAG=main

# Optional. Absolute public web origin for Rails (magic links, web_origin).
# Unset → production uses https://${SITE_DOMAIN}; development uses
# http://web.${APP_HOST}:${WEB_PORT}.
# WEB_URL=http://web.${APP_HOST}:${WEB_PORT}

# -----------------------------------------------------------------------------
# Core (Rails)
# -----------------------------------------------------------------------------
# Generate: `cd core && bin/rails secret`  (or `openssl rand -hex 64`)
SECRET_KEY_BASE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed when using encrypted credentials:
# RAILS_MASTER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared cookie Domain for Mode A (web.* + core.*). Empty / unset for Mode B.
SESSION_COOKIE_DOMAIN=.${APP_HOST}

# Run Solid Queue inside Puma (Mission Control + apps/web Jobs).
# false when using Docker Compose `worker` (`bin/jobs`).
SOLID_QUEUE_IN_PUMA=true

# SQLite paths for Docker Compose / production Rails only.
# Local `mise dev` ignores these — see core/config/database.yml development.
DB_NAME=storage/production.sqlite3
DB_NAME_CACHE=storage/production_cache.sqlite3
DB_NAME_QUEUE=storage/production_queue.sqlite3
DB_NAME_CABLE=storage/production_cable.sqlite3

# SMTP (optional for local Compose)
SMTP_ADDRESS=
SMTP_DOMAIN=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_ENABLED=true
# Contact address. Unified sender for mailers AND Web Push VAPID `sub` claim.
EMAIL_SENDER=noreply@example.com

# Mission Control::Jobs basic auth
MISSION_DASHBOARD_USERNAME=admin
MISSION_DASHBOARD_PASSWORD=change-me

# Web Push (optional). Generate: `mise run core` → create-vapid-key
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=

# DeepSeek (optional). Natural language beep create on the dashboard.
# DEEPSEEK_API_KEY=

# Creem billing (optional)
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true
# CREEM_PRODUCT_FIRST=
# CREEM_PRODUCT_STARTER=
# CREEM_PRODUCT_PRO=

# -----------------------------------------------------------------------------
# Web (apps/web)
# -----------------------------------------------------------------------------
# Browser bundle (Vite). Only VITE_* is inlined into client JS.
# Mode A (`mise dev`): absolute core origin. Prefer ${…} so ports stay single-sourced.
# Mode B (Compose / reverse proxy): empty → same-origin /api/v1.
VITE_CORE_URL=http://core.${APP_HOST}:${CORE_PORT}

# Server-only (SSR + Nitro /api proxy). Not exposed to the browser — do not
# prefix VITE_. Compose / Dokploy: http://core:80
CORE_INTERNAL_URL=http://core.${APP_HOST}:${CORE_PORT}

# -----------------------------------------------------------------------------
# GitHub Actions — Dokploy redeploy (repository secrets; do not commit real values)
# -----------------------------------------------------------------------------
# dokploy-deploy.yml redeploys the Compose service after image publish.
# DOKPLOY_URL=https://hz.yuler.dev
# DOKPLOY_API_KEY=
# DOKPLOY_COMPOSE_APPLICATION_ID=
