# =============================================================================
# beep — copy to `.env` and adjust
#   cp .env.example .env
# =============================================================================

# --- Local development (`mise dev`) ------------------------------------------
# Core: http://core.beep.localhost:${CORE_PORT}
CORE_PORT=3001
# Web:  http://web.beep.localhost:${WEB_PORT}
WEB_PORT=3000

# Run Solid Queue inside Puma (Mission Control + apps/web Jobs).
# Comment out / set false when using Docker Compose `worker` service.
SOLID_QUEUE_IN_PUMA=true

# Shared cookie Domain for Mode A (web.* + core.*). Leave unset for Mode B.
SESSION_COOKIE_DOMAIN=.beep.localhost

# Browser-facing (Vite). Prefer ${…} aliases so ports stay single-sourced.
# Mode B (Compose / reverse proxy): set VITE_CORE_URL= (empty) for same-origin /api/v1.
VITE_CORE_URL=http://core.beep.localhost:${CORE_PORT}

# Server-side (SSR + Nitro /api proxy). Defaults to Mode A local core.
# Compose sets this to http://core:80.
CORE_INTERNAL_URL=http://core.beep.localhost:${CORE_PORT}

# --- Docker Compose / production ---------------------------------------------
# Generate: `cd core && bin/rails secret`  (or `openssl rand -hex 64`)
SECRET_KEY_BASE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed when using encrypted credentials:
# RAILS_MASTER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SITE_DOMAIN=localhost:3000
SITE_NAME=beep

# Database (SQLite paths inside the core container)
DB_NAME=storage/production.sqlite3
DB_NAME_CACHE=storage/production_cache.sqlite3
DB_NAME_QUEUE=storage/production_queue.sqlite3
DB_NAME_CABLE=storage/production_cable.sqlite3

# SMTP (optional for local Compose)
SMTP_ADDRESS=
SMTP_DOMAIN=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_ENABLED=true
EMAIL_SENDER=noreply@example.com

# Mission Control::Jobs basic auth
MISSION_DASHBOARD_USERNAME=admin
MISSION_DASHBOARD_PASSWORD=change-me
