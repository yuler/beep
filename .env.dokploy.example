# Paste into the Dokploy Compose service → Environment tab.
# Dokploy writes this to `.env` next to compose.dokploy.yml.
# Do not copy a local `mise` `.env` (Mode A hosts / cookie domain).

# Public hostname only (no scheme). Must match the Dokploy domain on `web`.
SITE_DOMAIN=beep.example.com
SITE_NAME=beep

# Pin to a git tag image if you do not want `:main` (e.g. v1.2.3).
BEEP_IMAGE_TAG=main

# `cd core && bin/rails secret`
SECRET_KEY_BASE=

# Only if you use encrypted Rails credentials:
# RAILS_MASTER_KEY=

DB_NAME=storage/production.sqlite3
DB_NAME_CACHE=storage/production_cache.sqlite3
DB_NAME_QUEUE=storage/production_queue.sqlite3
DB_NAME_CABLE=storage/production_cable.sqlite3

SMTP_ADDRESS=
SMTP_DOMAIN=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL_ENABLED=true
# Contact address. Unified sender for mailers AND Web Push VAPID `sub` claim.
EMAIL_SENDER=noreply@example.com

MISSION_DASHBOARD_USERNAME=admin
MISSION_DASHBOARD_PASSWORD=

# Optional. Generate: `mise run core` → create-vapid-key
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
